<Window x:Class="PZManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PZ Manager" Height="700" Width="1120"
        MinHeight="560" MinWidth="900"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip">

    <Border Background="{StaticResource BgPrimaryBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0.5" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Border Grid.Row="0" Background="{StaticResource BgDeepBrush}"
                    CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Ellipse Width="8" Height="8" Fill="#FF4F9E6F" Margin="0,0,8,0"/>
                        <TextBlock Text="PZ Manager" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TbConfigName" Text="servertest" FontSize="12"
                                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="─" Width="28" Height="22" FontSize="12"
                                Style="{StaticResource DarkButton}" Padding="0" Margin="0,0,4,0"
                                Click="MinimizeBtn_Click"/>
                        <Button Content="✕" Width="28" Height="22" FontSize="12"
                                Style="{StaticResource DangerButton}" Padding="0"
                                Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- body -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- update banner — hidden until update check fires -->
                <Border x:Name="UpdateBanner" Grid.Row="0"
                        Background="#FF1A1400" BorderBrush="#FF3A3000"
                        BorderThickness="0,0,0,0.5" Padding="16,7"
                        Visibility="Collapsed" Cursor="Hand"
                        MouseLeftButtonUp="UpdateBanner_Click"
                        ToolTip="Click to open the releases page">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬆  " Foreground="#FFBF9B00" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbUpdateMsg"
                                   Foreground="#FFBF9B00" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="  —  click here to download"
                                   Foreground="#FF7A6000" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- sidebar + content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="185"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- sidebar — text only, no icons -->
                <Border Grid.Column="0" Background="{StaticResource BgDeepBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0.5,0"
                        CornerRadius="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,8,0,0">
                            <TextBlock Text="SERVER" Margin="16,8,0,4"
                                       FontSize="9" Foreground="{StaticResource TextDimBrush}" FontWeight="Medium"/>

                            <Button x:Name="NavMods"       Content="Mod Manager"    Style="{StaticResource NavButtonActive}" Click="Nav_Click" Tag="Mods"/>
                            <Button x:Name="NavSandbox"    Content="Sandbox"        Style="{StaticResource NavButton}"       Click="Nav_Click" Tag="Sandbox"/>
                            <Button x:Name="NavModSandbox" Content="Mod Sandbox"    Style="{StaticResource NavButton}"       Click="Nav_Click" Tag="ModSandbox"/>
                            <Button x:Name="NavConfig"     Content="Server Config"  Style="{StaticResource NavButton}"       Click="Nav_Click" Tag="Config"/>

                            <TextBlock Text="TOOLS" Margin="16,14,0,4"
                                       FontSize="9" Foreground="{StaticResource TextDimBrush}" FontWeight="Medium"/>

                            <Button x:Name="NavConsole"  Content="RCON Console"   Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Console"/>
                            <Button x:Name="NavRestart"  Content="Auto Restart"   Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Restart"/>
                            <Button x:Name="NavBackups"  Content="Backups"         Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Backups"/>
                            <Button x:Name="NavExport"   Content="Export"          Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Export"/>
                        </StackPanel>

                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0.5,0,0">
                            <StackPanel>
                                <Button x:Name="NavSettings" Content="Settings" Style="{StaticResource NavButton}" Margin="0,4,0,0" Click="Nav_Click" Tag="Settings"/>
                                <Button x:Name="NavAbout"    Content="About"    Style="{StaticResource NavButton}" Margin="0,0,0,4" Click="Nav_Click" Tag="About"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- content frame -->
                <Border Grid.Column="1" CornerRadius="0,0,10,0">
                    <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
                </Border>
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
