<Page x:Class="PZManager.Views.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:PZManager.Converters"
      Background="{StaticResource BgPrimaryBrush}" Title="Mods">
    <Page.Resources>
        <conv:StringToColorBrushConverter x:Key="ColorBrush"/>
        <Style x:Key="CellEdit" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderNormalBrush}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,0.5">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Mod Manager" Style="{StaticResource PageTitle}" Margin="0,0,10,0"/>
                    <Border Background="{StaticResource BgActiveBrush}" BorderBrush="{StaticResource BorderAccentBrush}"
                            BorderThickness="0.5" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                        <TextBlock x:Name="TbModCount" Text="0 mods" FontSize="11" Foreground="{StaticResource AccentGreenBrush}"/>
                    </Border>
                    <TextBlock x:Name="TbStatus" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Lookup All" Style="{StaticResource DarkButton}" Click="LookupAll_Click" x:Name="BtnLookup" Margin="0,0,6,0"/>
                    <Button Content="Import from .ini" Style="{StaticResource DarkButton}" Click="ImportIni_Click" Margin="0,0,6,0"/>
                    <Button Content="Copy output" Style="{StaticResource DarkButton}" Click="CopyOutput_Click" Margin="0,0,6,0"/>
                    <Button Content="Clear All" Style="{StaticResource DangerButton}" Click="ClearAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Padding="16,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,0.5" Background="{StaticResource BgSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TbModInput" Margin="0,0,8,0" FontFamily="Consolas, Courier New"
                         ToolTip="Paste Workshop IDs separated by ; or newlines"/>
                <Button Grid.Column="1" Content="Add IDs" Style="{StaticResource GreenButton}" Click="AddIds_Click"/>
            </Grid>
        </Border>
        <DataGrid Grid.Row="2" x:Name="ModGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="WORKSHOP ID" Binding="{Binding WorkshopId}" Width="130" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                            <Setter Property="Foreground" Value="{StaticResource MonoGreenBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="SCRAPED NAME" Binding="{Binding ScrapedName}" Width="190" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="MOD ID  (→ Mods=)" Binding="{Binding ModFolderId, UpdateSourceTrigger=PropertyChanged}" Width="160">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
                            <Setter Property="Padding" Value="10,9"/>
                            <Setter Property="MinHeight" Value="36"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource CellEdit}">
                            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DISPLAY NAME (override)" Binding="{Binding OverrideName, UpdateSourceTrigger=PropertyChanged}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="FontStyle" Value="Italic"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource CellEdit}"/>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <!-- version — read from mod.info on disk; "—" until server has run once -->
                <DataGridTextColumn Header="VERSION" Binding="{Binding VersionDisplay}" Width="80" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- dependencies — badge count + full list on tooltip -->
                <DataGridTemplateColumn Header="DEPS" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    ToolTip="{Binding DepsDisplay}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A1A1A"/>
                                        <Setter Property="CornerRadius" Value="4"/>
                                        <Setter Property="Padding" Value="6,2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDeps}" Value="True">
                                                <Setter Property="Background" Value="#FF1E1810"/>
                                                <Setter Property="BorderBrush" Value="#FF3A3010"/>
                                                <Setter Property="BorderThickness" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="none"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDeps}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFBF8C30"/>
                                                    <Setter Property="Text" Value="{Binding Dependencies.Count, StringFormat='⚑ {0}'}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="STATUS" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="8,0" Background="#1A1A1A">
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor, Converter={StaticResource ColorBrush}}" FontSize="11" VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="38">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕" Width="26" Height="22" FontSize="10" Style="{StaticResource DangerButton}" Tag="{Binding WorkshopId}" Click="DeleteMod_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="3" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0.5,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="16,10">
                    <StackPanel>
                        <TextBlock Text="GENERATED OUTPUT" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TbModsLine" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                        <TextBlock x:Name="TbWorkshopLine" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                        <TextBlock x:Name="TbWarning" Text="" FontSize="11" Foreground="{StaticResource StatusWarnFgBrush}" Visibility="Collapsed" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0.5,0,0,0" Padding="16,10">
                    <StackPanel VerticalAlignment="Center">
                        <Button x:Name="BtnSave" Style="{StaticResource GreenButton}" Width="160" Height="40" FontSize="13" Click="SaveIni_Click" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Save to .ini" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="TbSaveStatus" Text="" FontSize="11" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="160"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
