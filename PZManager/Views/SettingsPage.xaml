<Page x:Class="PZManager.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgPrimaryBrush}" Title="Settings">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,0.5">
            <Grid Margin="16,0">
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Save Settings" Style="{StaticResource GreenButton}" Click="Save_Click"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" Padding="16,12">
            <StackPanel>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="DIRECTORIES" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Install Directory" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TbServerDir" Margin="0,0,8,0" FontFamily="Consolas, Courier New" FontSize="12"
                                     ToolTip="Where StartServer64.bat lives — the SteamCMD install folder"/>
                            <Button Grid.Column="2" Content="Browse…" Style="{StaticResource DarkButton}" Tag="server" Click="Browse_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Config Directory" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TbConfigDir" Margin="0,0,8,0" FontFamily="Consolas, Courier New" FontSize="12"
                                     ToolTip="Where servertest.ini, SandboxVars.lua, and Logs live — usually %userprofile%\Zomboid\Server"/>
                            <Button Grid.Column="2" Content="Browse…" Style="{StaticResource DarkButton}" Tag="config" Click="Browse_Click"/>
                        </Grid>
                        <TextBlock Text="Install dir and Config dir are different locations. SteamCMD puts the game files in one place, PZ puts user data in another."
                                   Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="180,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="SERVER IDENTITY" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Config Name" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TbConfigName" ToolTip="The name used for servertest.ini — without the .ini extension"/>
                        </Grid>
                        <TextBlock Text="This should match your .ini filename without the extension (e.g. 'servertest' for servertest.ini)."
                                   Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="180,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="RCON" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RCON Host" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TbRconHost" ToolTip="127.0.0.1 if running on the same machine"/>
                        </Grid>
                        <TextBlock Text="Port and password are read from the .ini file automatically." Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="180,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="STEAM API KEY  (optional)" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="API Key" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TbSteamApiKey" FontFamily="Consolas, Courier New" FontSize="12"/>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextDimBrush}">
                            <Run>Without a key, mod names and Mod IDs are fetched but dependency (Required Items) data may be incomplete.</Run>
                            <LineBreak/>
                            <Run>Get a free key at steamcommunity.com/dev/apikey — any domain name works. Leave blank to skip.</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                        <CheckBox x:Name="CbAutoFetch" Content="Auto-fetch mod names from Steam Workshop when adding IDs" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="EMERGENCY" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Force Kill Server" Style="{StaticResource DangerButton}"
                                    Click="ForceKill_Click" Padding="14,8"
                                    ToolTip="Immediately kills the server process and all child processes (the JVM). Use if Stop Server isn't working."/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                   Text="Kills the server process tree immediately without a graceful shutdown. Use only if the RCON Console's Stop Server button isn't responding. No save is performed."/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TbSaveStatus" Text="" FontSize="12" Foreground="{StaticResource AccentGreenBrush}" Margin="4,0,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
