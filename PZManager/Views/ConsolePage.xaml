<Page x:Class="PZManager.Views.ConsolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:PZManager.Converters"
      Background="{StaticResource BgPrimaryBrush}" Title="Console">
    <Page.Resources>
        <conv:StringToColorBrushConverter x:Key="ColorBrush"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,0.5">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RCON Console" Style="{StaticResource PageTitle}" Margin="0,0,10,0"/>
                    <Border x:Name="RconBadge" Background="#FF221416" BorderBrush="#FF3A1E1E"
                            BorderThickness="0.5" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                        <TextBlock x:Name="TbRconStatus" Text="● rcon off" FontSize="11" Foreground="#FF9E3A3A"/>
                    </Border>
                    <Border x:Name="ServerBadge" Background="#FF1E1810" BorderBrush="#FF3A3010"
                            BorderThickness="0.5" CornerRadius="4" Padding="8,2">
                        <TextBlock x:Name="TbServerStatus" Text="● server stopped" FontSize="11" Foreground="#FFBF8C30"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnLaunch" Content="Launch Server" Style="{StaticResource GreenButton}" Margin="0,0,6,0" Click="Launch_Click"/>
                    <Button x:Name="BtnStopServer" Content="Stop Server" Style="{StaticResource DangerButton}" IsEnabled="False" Margin="0,0,6,0" Click="StopServer_Click"/>
                    <Button x:Name="BtnConnect" Content="RCON Connect" Style="{StaticResource DarkButton}" Margin="0,0,6,0" Click="Connect_Click"/>
                    <Button Content="Clear" Style="{StaticResource DarkButton}" Click="Clear_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource BgDeepBrush}">
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Padding="12,8">
                <ItemsControl x:Name="LogList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontFamily="Consolas, Courier New"
                                           FontSize="11" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding Message}" FontFamily="Consolas, Courier New"
                                           FontSize="12" Foreground="{Binding Color, Converter={StaticResource ColorBrush}}"
                                           TextWrapping="Wrap" VerticalAlignment="Top"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0.5,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&gt;" FontFamily="Consolas, Courier New" FontSize="14"
                           Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="TbCommand" FontFamily="Consolas, Courier New"
                         Padding="6,6" Margin="0,0,8,0" KeyDown="Command_KeyDown"/>
                <Button Grid.Column="2" Content="Send" Style="{StaticResource GreenButton}"
                        Width="70" Click="Send_Click" x:Name="BtnSend"/>
            </Grid>
        </Border>
    </Grid>
</Page>
