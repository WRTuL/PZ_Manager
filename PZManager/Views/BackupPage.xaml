<Page x:Class="PZManager.Views.BackupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgPrimaryBrush}" Title="Backups">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- top bar -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,0.5">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Backups" Style="{StaticResource PageTitle}" Margin="0,0,10,0"/>
                    <Border Background="{StaticResource BgActiveBrush}"
                            BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="0.5"
                            CornerRadius="4" Padding="8,2">
                        <TextBlock x:Name="TbCount" Text="0 backups"
                                   FontSize="11" Foreground="{StaticResource AccentGreenBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Backup Now" Style="{StaticResource GreenButton}"
                            Click="BackupNow_Click" Margin="0,0,6,0"
                            ToolTip="Snapshot config, sandbox, and mod list right now"/>
                    <Button Content="Open Folder" Style="{StaticResource DarkButton}"
                            Click="OpenFolder_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">

            <!-- settings strip -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,10"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,0.5"
                    Background="{StaticResource BgSecondaryBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Keep last" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="TbKeep" Text="10" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="2" Text="backups  ·  auto-backup on restart"
                               VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" Margin="0,0,12,0"/>
                    <CheckBox Grid.Column="3" x:Name="CbAutoBackup" Content="enabled"
                              VerticalAlignment="Center"
                              ToolTip="Takes a backup automatically before each auto-restart"/>
                    <TextBlock Grid.Column="4" x:Name="TbStatus" Text=""
                               Foreground="{StaticResource AccentGreenBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- backup list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,8">
                <StackPanel x:Name="BackupList"/>
            </ScrollViewer>

            <!-- empty state -->
            <StackPanel x:Name="PanelEmpty" Grid.Row="1"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="No backups yet." FontSize="15"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Click 'Backup Now' to create your first snapshot."
                           FontSize="13" Foreground="{StaticResource TextDimBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- footer note -->
            <Border Grid.Row="2" Padding="16,8"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0.5,0,0"
                    Background="{StaticResource BgSecondaryBrush}">
                <TextBlock x:Name="TbBackupPath" FontFamily="Consolas, Courier New" FontSize="11"
                           Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
            </Border>

        </Grid>
    </Grid>
</Page>
